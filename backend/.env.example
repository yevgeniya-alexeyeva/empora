# Required; allowed values are development, test, and production.
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://empora:empora@localhost:5432/empora
# Replace both placeholders with different, random secrets of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-random-access-secret-32-plus-chars
JWT_REFRESH_SECRET=replace-with-random-refresh-secret-32-plus-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
# Swagger defaults to true only in development; set it explicitly in deployments.
SWAGGER_ENABLED=true
ADMIN_EMAIL=admin@empora.local
# Required in production; use 12+ characters with upper/lower-case, number, and symbol.
ADMIN_PASSWORD=replace-With-A-Strong-Password-123!
